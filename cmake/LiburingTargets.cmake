include_guard(GLOBAL)

function(liburing_create_libraries)
  if(NOT TARGET uarch::uarch)
    find_package(uarch CONFIG QUIET HINTS /root/uarch /root/.local/vcpkg/uarch)
  endif()
  # Source fallback is local-only. CI runners install uarch and export CMAKE_PREFIX_PATH.
  if(NOT TARGET uarch::uarch AND NOT uarch_FOUND AND EXISTS "/root/uarch/CMakeLists.txt")
    set(UARCH_BUILD_TESTS OFF)
    set(UARCH_BUILD_BENCHES OFF)
    set(UARCH_BUILD_TOOLS OFF)
    add_subdirectory("/root/uarch" "${CMAKE_CURRENT_BINARY_DIR}/_deps/uarch-build" SYSTEM EXCLUDE_FROM_ALL)
  endif()
  if(NOT TARGET uarch::uarch)
    message(FATAL_ERROR
      "uarch::uarch was not found. Install uarch and add its prefix to CMAKE_PREFIX_PATH, "
      "or provide /root/uarch/CMakeLists.txt.")
  endif()
  foreach(layer IN ITEMS error abi sys caps core ring ops resources futex2)
    add_library(liburing_${layer} INTERFACE)
    add_library(liburing::${layer} ALIAS liburing_${layer})
    set_target_properties(liburing_${layer} PROPERTIES EXPORT_NAME ${layer})
    target_link_libraries(liburing_${layer} INTERFACE uarch::uarch)
    target_compile_features(liburing_${layer} INTERFACE cxx_std_26)
    target_include_directories(liburing_${layer} INTERFACE
      "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/include>"
      "$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>")
  endforeach()
  target_link_libraries(liburing_abi INTERFACE liburing::error)
  target_link_libraries(liburing_sys INTERFACE liburing::abi)
  target_link_libraries(liburing_caps INTERFACE liburing::sys)
  target_link_libraries(liburing_core INTERFACE liburing::caps)
  target_link_libraries(liburing_ring INTERFACE liburing::core)
  target_link_libraries(liburing_ops INTERFACE liburing::ring)
  target_link_libraries(liburing_resources INTERFACE liburing::ring)
  target_link_libraries(liburing_futex2 INTERFACE liburing::ring)
  add_library(liburing INTERFACE)
  add_library(liburing::liburing ALIAS liburing)
  target_link_libraries(liburing INTERFACE uarch::uarch liburing::error liburing::abi liburing::sys
    liburing::caps liburing::core liburing::ring liburing::ops liburing::resources liburing::futex2)
  install(TARGETS liburing_error liburing_caps liburing_ring EXPORT liburing-targets)
endfunction()

function(liburing_configure_internal target)
  cmake_parse_arguments(PARSE_ARGV 1 ARG "NO_SANITIZERS" "" "")
  target_link_libraries(${target} PRIVATE liburing::liburing)
  set_target_properties(${target} PROPERTIES CXX_EXTENSIONS OFF)
  if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    set_property(TARGET ${target} APPEND PROPERTY BUILD_RPATH "${CMAKE_CXX_IMPLICIT_LINK_DIRECTORIES}")
    # A sysroot libc in RUNPATH must use its matching loader, not the host glibc loader.
    execute_process(COMMAND "${CMAKE_CXX_COMPILER}" -print-file-name=ld-linux-x86-64.so.2
      OUTPUT_VARIABLE runtime_loader OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE loader_status)
    if(NOT (loader_status EQUAL 0 AND IS_ABSOLUTE "${runtime_loader}" AND EXISTS "${runtime_loader}"))
      execute_process(COMMAND "${CMAKE_CXX_COMPILER}" -print-file-name=ld-musl-x86_64.so.1
        OUTPUT_VARIABLE runtime_loader OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE loader_status)
    endif()
    if(loader_status EQUAL 0 AND IS_ABSOLUTE "${runtime_loader}" AND EXISTS "${runtime_loader}")
      target_link_options(${target} PRIVATE "LINKER:--dynamic-linker,${runtime_loader}")
    endif()
  elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    foreach(directory IN LISTS CMAKE_CXX_IMPLICIT_LINK_DIRECTORIES)
      # Use compiler runtimes without replacing the host loader's libc on glibc targets.
      if(CMAKE_CXX_COMPILER MATCHES "musl" OR NOT directory MATCHES "/sysroot(/|$)")
        set_property(TARGET ${target} APPEND PROPERTY BUILD_RPATH "${directory}")
      endif()
    endforeach()
    if(CMAKE_CXX_COMPILER MATCHES "musl")
      execute_process(COMMAND "${CMAKE_CXX_COMPILER}" -print-file-name=ld-musl-x86_64.so.1
        OUTPUT_VARIABLE runtime_loader OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE loader_status)
      if(loader_status EQUAL 0 AND IS_ABSOLUTE "${runtime_loader}" AND EXISTS "${runtime_loader}")
        target_link_options(${target} PRIVATE "LINKER:--dynamic-linker,${runtime_loader}")
      endif()
    endif()
  endif()
  liburing_enable_warnings(${target})
  if(NOT ARG_NO_SANITIZERS)
    liburing_enable_sanitizers(${target})
  endif()
endfunction()

function(liburing_add_test target)
  add_executable(${target} ${ARGN})
  liburing_configure_internal(${target})
  add_test(NAME ${target} COMMAND ${target})
endfunction()
